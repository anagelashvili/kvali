# Copy to .env.local. Values come from `npx supabase status` locally,
# or Supabase dashboard → Project Settings → API keys in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Any random string; keeps hashed IPs used for rate limiting unguessable.
RATE_LIMIT_SALT=
# Optional: emails artists about new requests. Without it, notifications are only logged.
RESEND_API_KEY=
MAIL_FROM=Kvali <hello@kvali.ink>
